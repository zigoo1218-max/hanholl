# ===== 필수: 텔레그램 =====
# @BotFather 에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=
# 알림을 받을 채팅 ID (개인 / 그룹 / 채널). README 의 "chat_id 확인 방법" 참고
TELEGRAM_CHAT_ID=

# ===== 권장: 공공데이터포털 API 인증키 =====
# 일반 인증키(Decoding) 1개를 아래 3개 서비스에 모두 "활용신청" 하면 같은 키로 전부 쓸 수 있습니다.
#  - 한국토지주택공사_분양임대공고문 조회 서비스   (LH. 키가 없어도 웹 목록으로 동작)
#  - 국토교통부_마이홈포털 공공주택 모집공고 조회 서비스 (GH·iH·지방공사 공공분양/임대. 키 필수)
#  - 한국부동산원_청약홈 분양정보 조회 서비스        (민간분양·민간 무순위. 키 필수)
DATA_GO_KR_API_KEY=
# 서비스별로 다른 키를 쓰고 싶을 때만 입력 (비우면 DATA_GO_KR_API_KEY 사용)
MYHOME_API_KEY=
APPLYHOME_API_KEY=

# ===== 선택: 모니터링 조건 (기본값이 있으므로 비워둬도 됨) =====
# 쉼표로 구분한 지구명
TARGET_REGIONS=부천대장,하남교산,부천역곡,인천계양
# 임대 공고(행복주택·통합공공임대 등)도 알릴지 여부
INCLUDE_RENTAL=true
# 마이홈포털(GH·iH·지방공사 등 공공주택) 공고를 확인할지 여부
ENABLE_MYHOME=true
# 청약홈(민간분양·무순위·임의공급·공공지원민간임대) 공고를 확인할지 여부
ENABLE_APPLYHOME=true
# SH(서울주택도시공사) 공고도 함께 확인할지 여부 (서울 물량이라 대상 지구에는 거의 해당 없음)
ENABLE_SH=true
# 최근 며칠 이내 게시된 공고를 확인할지
LOOKBACK_DAYS=30
# 제목에 지구명이 없을 때 공고 상세 본문까지 열어서 확인할지
CHECK_DETAIL=true
# 한 번 실행할 때 상세 본문을 최대 몇 건까지 열어볼지 (사이트 부하 방지)
MAX_DETAIL_FETCH=30

# 발송 이력 DB 경로 (lh-monitor 폴더 기준 상대경로 또는 절대경로)
STATE_DB_PATH=data/state.db
